{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "form-bazar-sakura",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "404-page"
  }
}
